[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/field/field_screen.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/field_art.gd" id="2_art"]

[node name="FieldScreen" type="ColorRect"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.025, 0.022, 1)
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Root" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

; --- Colonne de gauche : titre fin, image maximale, bandeau de texte -----------
; L'image occupe toute la zone centrale (ArtFrame en expansion) et s'affiche en
; ENTIER (contain) dans son cadre 16:9 : aucune partie n'est cachée par les menus,
; qui sont à côté et jamais par-dessus. Les zones cliquables sont posées sur %Art.
[node name="Left" type="VBoxContainer" parent="Margin/Root"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="TopBar" type="HBoxContainer" parent="Margin/Root/Left"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Margin/Root/Left/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"

[node name="TurnsLabel" type="Label" parent="Margin/Root/Left/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 1
theme_type_variation = &"MutedLabel"

[node name="ArtFrame" type="PanelContainer" parent="Margin/Root/Left"]
clip_contents = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"TerminalPanel"

[node name="ArtRatio" type="AspectRatioContainer" parent="Margin/Root/Left/ArtFrame"]
layout_mode = 2
ratio = 1.7777778
stretch_mode = 2

[node name="Art" type="Control" parent="Margin/Root/Left/ArtFrame/ArtRatio"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_art")

[node name="BottomPanel" type="PanelContainer" parent="Margin/Root/Left"]
layout_mode = 2
theme_type_variation = &"DocumentPanel"

[node name="BottomInner" type="MarginContainer" parent="Margin/Root/Left/BottomPanel"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 10

[node name="BottomBox" type="VBoxContainer" parent="Margin/Root/Left/BottomPanel/BottomInner"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LogScroll" type="ScrollContainer" parent="Margin/Root/Left/BottomPanel/BottomInner/BottomBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 96)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="LogLabel" type="Label" parent="Margin/Root/Left/BottomPanel/BottomInner/BottomBox/LogScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DocumentLabel"
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Margin/Root/Left/BottomPanel/BottomInner/BottomBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HintLabel" type="Label" parent="Margin/Root/Left/BottomPanel/BottomInner/BottomBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="LeaveButton" type="Button" parent="Margin/Root/Left/BottomPanel/BottomInner/BottomBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 46)
layout_mode = 2
text = "PARTIR"

; --- Colonne de droite : les choix (jamais par-dessus l'image) -----------------
[node name="SidePanel" type="PanelContainer" parent="Margin/Root"]
custom_minimum_size = Vector2(300, 0)
layout_mode = 2
theme_type_variation = &"DocumentPanel"

[node name="SideInner" type="MarginContainer" parent="Margin/Root/SidePanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="OptionsScroll" type="ScrollContainer" parent="Margin/Root/SidePanel/SideInner"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="OptionsBox" type="VBoxContainer" parent="Margin/Root/SidePanel/SideInner/OptionsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
