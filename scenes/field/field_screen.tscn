[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/field/field_screen.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/field_art.gd" id="2_art"]

[node name="FieldScreen" type="ColorRect"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.025, 0.022, 1)
script = ExtResource("1_script")

; --- Décor en fond, plein écran -----------------------------------------------
; L'image (ou la vidéo, ou la 3D) occupe tout l'écran, affichée en entier dans un
; cadre 16:9 centré (contain). Les zones cliquables sont posées dessus par le
; script. Les panneaux de texte et de choix flottent par-dessus (calque Overlay).
[node name="ArtFrame" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"TerminalPanel"

[node name="ArtRatio" type="AspectRatioContainer" parent="ArtFrame"]
layout_mode = 2
ratio = 1.7777778
stretch_mode = 2

[node name="Art" type="Control" parent="ArtFrame/ArtRatio"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_art")

; --- Calque des panneaux (par-dessus l'image) ---------------------------------
; Inerte à la souris (MOUSE_FILTER_IGNORE) : les clics passent au travers vers les
; zones de l'image, sauf là où un panneau translucide (STOP) les intercepte. Les
; panneaux sont volontairement semi-transparents (self_modulate) pour l'immersion.
[node name="Overlay" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 0

[node name="TopBar" type="PanelContainer" parent="Overlay"]
layout_mode = 2
self_modulate = Color(1, 1, 1, 0.9)
theme_type_variation = &"TerminalPanel"

[node name="TopBarInner" type="MarginContainer" parent="Overlay/TopBar"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 10

[node name="Header" type="HBoxContainer" parent="Overlay/TopBar/TopBarInner"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Overlay/TopBar/TopBarInner/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeaderLabel"

[node name="TurnsLabel" type="Label" parent="Overlay/TopBar/TopBarInner/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 1
theme_type_variation = &"MutedLabel"

[node name="Middle" type="HBoxContainer" parent="Overlay"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 0

[node name="Spacer" type="Control" parent="Overlay/Middle"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="SidePanel" type="PanelContainer" parent="Overlay/Middle"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
size_flags_vertical = 3
self_modulate = Color(1, 1, 1, 0.92)
theme_type_variation = &"DocumentPanel"

[node name="SideInner" type="MarginContainer" parent="Overlay/Middle/SidePanel"]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 14

[node name="OptionsScroll" type="ScrollContainer" parent="Overlay/Middle/SidePanel/SideInner"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="OptionsBox" type="VBoxContainer" parent="Overlay/Middle/SidePanel/SideInner/OptionsScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="BottomPanel" type="PanelContainer" parent="Overlay"]
layout_mode = 2
self_modulate = Color(1, 1, 1, 0.92)
theme_type_variation = &"DocumentPanel"

[node name="BottomInner" type="MarginContainer" parent="Overlay/BottomPanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 12

[node name="BottomBox" type="VBoxContainer" parent="Overlay/BottomPanel/BottomInner"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LogScroll" type="ScrollContainer" parent="Overlay/BottomPanel/BottomInner/BottomBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="LogLabel" type="Label" parent="Overlay/BottomPanel/BottomInner/BottomBox/LogScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DocumentLabel"
autowrap_mode = 3

[node name="Footer" type="HBoxContainer" parent="Overlay/BottomPanel/BottomInner/BottomBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="HintLabel" type="Label" parent="Overlay/BottomPanel/BottomInner/BottomBox/Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="LeaveButton" type="Button" parent="Overlay/BottomPanel/BottomInner/BottomBox/Footer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
text = "PARTIR"
