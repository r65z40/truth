[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/windows/news_window.gd" id="1_script"]

[node name="NewsWindow" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 180.0
offset_top = 40.0
offset_right = -180.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
window_title = "JOURNAL DU MATIN"
app_icon = "news"
task_title = "Journal"
classification = ""

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Content" type="MarginContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Paper" type="PanelContainer" parent="Layout/Content"]
layout_mode = 2
theme_type_variation = &"DocumentPanel"

[node name="Scroll" type="ScrollContainer" parent="Layout/Content/Paper"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Page" type="VBoxContainer" parent="Layout/Content/Paper/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Masthead" type="Label" parent="Layout/Content/Paper/Scroll/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentLabel"
theme_override_font_sizes/font_size = 34
text = "LA VOIX DE VELMIRA"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Tagline" type="Label" parent="Layout/Content/Paper/Scroll/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentMeta"
horizontal_alignment = 1
autowrap_mode = 3

[node name="Rule" type="HSeparator" parent="Layout/Content/Paper/Scroll/Page"]
layout_mode = 2

[node name="Articles" type="VBoxContainer" parent="Layout/Content/Paper/Scroll/Page"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14
