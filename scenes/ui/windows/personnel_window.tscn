[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/windows/personnel_window.gd" id="1_script"]

[node name="PersonnelWindow" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 160.0
offset_top = 70.0
offset_right = -160.0
offset_bottom = -70.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
window_title = "DOSSIER PERSONNEL  //  DIRECTION DU PERSONNEL"
classification = "CONFIDENTIEL"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Content" type="MarginContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Paper" type="PanelContainer" parent="Layout/Content"]
layout_mode = 2
theme_type_variation = &"DocumentPanel"

[node name="PersonnelText" type="RichTextLabel" parent="Layout/Content/Paper"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentText"
bbcode_enabled = true
