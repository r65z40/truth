[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/windows/messages_window.gd" id="1_script"]

[node name="MessagesWindow" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 80.0
offset_top = 48.0
offset_right = -80.0
offset_bottom = -48.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
window_title = "COURRIER INTERNE  //  LIAISON SÉCURISÉE"
app_icon = "messages"
task_title = "Courrier"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Content" type="MarginContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Columns" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ListColumn" type="VBoxContainer" parent="Layout/Content/Columns"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2
theme_override_constants/separation = 6

[node name="ListTitle" type="Label" parent="Layout/Content/Columns/ListColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "PLIS REÇUS"

[node name="ListScroll" type="ScrollContainer" parent="Layout/Content/Columns/ListColumn"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="MessageList" type="VBoxContainer" parent="Layout/Content/Columns/ListColumn/ListScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TrashButton" type="Button" parent="Layout/Content/Columns/ListColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
toggle_mode = true
text = "CORBEILLE"

[node name="Reader" type="VBoxContainer" parent="Layout/Content/Columns"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Letter" type="PanelContainer" parent="Layout/Content/Columns/Reader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"DocumentPanel"

[node name="LetterScroll" type="ScrollContainer" parent="Layout/Content/Columns/Reader/Letter"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="LetterContent" type="VBoxContainer" parent="Layout/Content/Columns/Reader/Letter/LetterScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Letterhead" type="HBoxContainer" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent"]
layout_mode = 2

[node name="Ministry" type="Label" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent/Letterhead"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"DocumentLabel"
theme_override_font_sizes/font_size = 15
text = "MINISTÈRE DE LA SÉCURITÉ NATIONALE
Courrier interne  //  Section 4"

[node name="Stamp" type="Label" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent/Letterhead"]
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"StampLabel"
text = "[ DIFFUSION RESTREINTE ]"

[node name="MessageHeader" type="Label" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentMeta"
autowrap_mode = 3

[node name="MessageSubject" type="Label" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentLabel"
theme_override_font_sizes/font_size = 19
autowrap_mode = 3

[node name="MessageBody" type="RichTextLabel" parent="Layout/Content/Columns/Reader/Letter/LetterScroll/LetterContent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DocumentText"
bbcode_enabled = true
fit_content = true
selection_enabled = true

[node name="EmptyHint" type="Label" parent="Layout/Content/Columns/Reader"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MutedLabel"
text = "Aucun pli. Le courrier de la hiérarchie arrivera ici."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="LetterActions" type="HBoxContainer" parent="Layout/Content/Columns/Reader"]
unique_name_in_owner = true
layout_mode = 2
alignment = 2

[node name="DeleteButton" type="Button" parent="Layout/Content/Columns/Reader/LetterActions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
text = "SUPPRIMER"
