[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/windows/messages_window.gd" id="1_script"]

[node name="MessagesWindow" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 80.0
offset_top = 48.0
offset_right = -80.0
offset_bottom = -48.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
window_title = "COURRIER INTERNE  //  LIAISON SÉCURISÉE"
app_icon = "messages"
task_title = "Courrier"

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 0

[node name="Content" type="MarginContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 14

[node name="Columns" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ListScroll" type="ScrollContainer" parent="Layout/Content/Columns"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="MessageList" type="VBoxContainer" parent="Layout/Content/Columns/ListScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Reader" type="PanelContainer" parent="Layout/Content/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TerminalPanel"

[node name="ReaderLayout" type="VBoxContainer" parent="Layout/Content/Columns/Reader"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MessageHeader" type="Label" parent="Layout/Content/Columns/Reader/ReaderLayout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
autowrap_mode = 3

[node name="Rule" type="ColorRect" parent="Layout/Content/Columns/Reader/ReaderLayout"]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
color = Color(0.122, 0.42, 0.247, 1)

[node name="MessageBody" type="RichTextLabel" parent="Layout/Content/Columns/Reader/ReaderLayout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"TerminalText"
bbcode_enabled = true
selection_enabled = true
