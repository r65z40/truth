[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/desk/desk.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/terminal/terminal.tscn" id="2_terminal"]
[ext_resource type="PackedScene" path="res://scenes/ui/windows/dossiers_window.tscn" id="3_dossiers"]
[ext_resource type="PackedScene" path="res://scenes/ui/windows/messages_window.tscn" id="4_messages"]
[ext_resource type="PackedScene" path="res://scenes/ui/windows/archives_window.tscn" id="5_archives"]
[ext_resource type="Texture2D" path="res://icon.svg" id="6_icon"]
[ext_resource type="PackedScene" path="res://scenes/ui/windows/personnel_window.tscn" id="7_personnel"]

[node name="Desk" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.067, 0.075, 0.071, 1)

[node name="Main" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 0

[node name="TopBar" type="PanelContainer" parent="Main"]
layout_mode = 2
theme_type_variation = &"TopBar"

[node name="Row" type="HBoxContainer" parent="Main/TopBar"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Emblem" type="TextureRect" parent="Main/TopBar/Row"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
texture = ExtResource("6_icon")
expand_mode = 1
stretch_mode = 5

[node name="Ministry" type="VBoxContainer" parent="Main/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="MinistryName" type="Label" parent="Main/TopBar/Row/Ministry"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "MINISTÈRE DE LA SÉCURITÉ NATIONALE"
clip_text = true

[node name="Section" type="Label" parent="Main/TopBar/Row/Ministry"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Section 4  //  Inspection des dossiers civils"
clip_text = true

[node name="Agent" type="VBoxContainer" parent="Main/TopBar/Row"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="AgentLabel" type="Label" parent="Main/TopBar/Row/Agent"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 2

[node name="RankLabel" type="Label" parent="Main/TopBar/Row/Agent"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
horizontal_alignment = 2

[node name="Separator" type="ColorRect" parent="Main/TopBar/Row"]
custom_minimum_size = Vector2(2, 0)
layout_mode = 2
color = Color(0.239, 0.267, 0.259, 1)

[node name="DateLabel" type="Label" parent="Main/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 19

[node name="Body" type="MarginContainer" parent="Main"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 12

[node name="Columns" type="HBoxContainer" parent="Main/Body"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Terminal" parent="Main/Body/Columns" instance=ExtResource("2_terminal")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 2.6

[node name="Side" type="VBoxContainer" parent="Main/Body/Columns"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="SideTitle" type="Label" parent="Main/Body/Columns/Side"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "POSTE DE TRAVAIL"

[node name="DossiersButton" type="Button" parent="Main/Body/Columns/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
focus_mode = 0
text = "DOSSIERS"
alignment = 0

[node name="MessagesButton" type="Button" parent="Main/Body/Columns/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
focus_mode = 0
text = "MESSAGES"
alignment = 0

[node name="ArchivesButton" type="Button" parent="Main/Body/Columns/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
focus_mode = 0
text = "ARCHIVES"
alignment = 0

[node name="PersonnelButton" type="Button" parent="Main/Body/Columns/Side"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
focus_mode = 0
text = "DOSSIER PERSONNEL"
alignment = 0

[node name="Spacer" type="Control" parent="Main/Body/Columns/Side"]
layout_mode = 2
size_flags_vertical = 3

[node name="Poster" type="PanelContainer" parent="Main/Body/Columns/Side"]
layout_mode = 2
theme_type_variation = &"DocumentPanel"

[node name="PosterText" type="Label" parent="Main/Body/Columns/Side/Poster"]
layout_mode = 2
theme_type_variation = &"DocumentLabel"
theme_override_colors/font_color = Color(0.557, 0.122, 0.122, 1)
theme_override_font_sizes/font_size = 20
text = "LA VIGILANCE
EST UN
DEVOIR CIVIQUE"
horizontal_alignment = 1
autowrap_mode = 3

[node name="BottomBar" type="PanelContainer" parent="Main"]
layout_mode = 2
theme_type_variation = &"TopBar"

[node name="Row" type="HBoxContainer" parent="Main/BottomBar"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="StatusLabel" type="Label" parent="Main/BottomBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MutedLabel"
text = "LIAISON SÉCURISÉE  //  TOUTE ACTIVITÉ EST ENREGISTRÉE"
clip_text = true

[node name="EndDayButton" type="Button" parent="Main/BottomBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
text = "FIN DE SERVICE"

[node name="SaveButton" type="Button" parent="Main/BottomBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
text = "SAUVEGARDER"

[node name="MenuButton" type="Button" parent="Main/BottomBar/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
focus_mode = 0
theme_type_variation = &"AlertButton"
text = "DÉCONNEXION"

[node name="WindowLayer" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Scrim" type="ColorRect" parent="WindowLayer"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)

[node name="DossiersWindow" parent="WindowLayer" instance=ExtResource("3_dossiers")]
unique_name_in_owner = true
layout_mode = 1

[node name="MessagesWindow" parent="WindowLayer" instance=ExtResource("4_messages")]
unique_name_in_owner = true
layout_mode = 1

[node name="ArchivesWindow" parent="WindowLayer" instance=ExtResource("5_archives")]
unique_name_in_owner = true
layout_mode = 1

[node name="PersonnelWindow" parent="WindowLayer" instance=ExtResource("7_personnel")]
unique_name_in_owner = true
layout_mode = 1

[node name="DayTransition" type="ColorRect" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.025, 0.022, 1)

[node name="DayTransitionLabel" type="Label" parent="DayTransition"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"HeaderLabel"
theme_override_font_sizes/font_size = 34
horizontal_alignment = 1
vertical_alignment = 1
