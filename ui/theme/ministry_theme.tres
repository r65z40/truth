[gd_resource type="Theme" format=3]

; Palette (see ARCHITECTURE.md > Direction visuelle) :
;   fond        #0b0d0c   anthracite  #1b1f1e / #262b2a   bordure #3d4442
;   phosphore   #3ce07a   phosphore sombre #1f6b3f
;   blanc cassé #e8e4d8   beige document #d8ccad   encre #2a241c
;   rouge alerte #8e1f1f / #d04a3a

[sub_resource type="SystemFont" id="font_mono"]
font_names = PackedStringArray("IBM Plex Mono", "Consolas", "Courier New", "DejaVu Sans Mono", "Liberation Mono", "Monospace")
font_weight = 500
antialiasing = 1
hinting = 1

[sub_resource type="SystemFont" id="font_mono_bold"]
font_names = PackedStringArray("IBM Plex Mono", "Consolas", "Courier New", "DejaVu Sans Mono", "Liberation Mono", "Monospace")
font_weight = 700
antialiasing = 1
hinting = 1

